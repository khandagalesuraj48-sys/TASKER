# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Single-User Identity Configuration
VITE_DEFAULT_USER_NAME=Pawan

# Application Security Access Key (Optional but recommended for public Vercel deployment)
# If provided, this key is passed in headers ('x-app-access-key') to protect RLS and endpoints from public internet bots.
VITE_APP_ACCESS_KEY=your-custom-app-secret-key

# Release Automation (Local Server-Side Only - NEVER commit or expose to frontend)
# Used exclusively by 'npm run release' to upload APK to Supabase Storage and register release in app_releases
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
